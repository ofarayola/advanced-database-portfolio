Project carepoint_clinic {
  database_type: 'PostgreSQL'
  Note: 'CarePoint Specialist Clinic - MIT 8103 Advanced Database Systems, Portfolio 1'
}

// ---------- Allowed values ----------
Enum appointment_status {
  scheduled
  completed
  cancelled
  no_show
}

Enum lab_status {
  ordered
  sample_collected
  completed
  cancelled
}

Enum invoice_status {
  unpaid
  part_paid
  paid
}

Enum payment_method {
  cash
  card
  transfer
  hmo
}

// ---------- Organisation ----------
Table branch {
  branch_id int [pk, increment]
  name varchar(50) [not null, unique]
  address varchar(200) [not null]
  phone varchar(20)
}

Table department {
  department_id int [pk, increment]
  branch_id int [not null, ref: > branch.branch_id]
  name varchar(50) [not null]
  indexes {
    (branch_id, name) [unique]
  }
}

Table doctor {
  doctor_id int [pk, increment]
  department_id int [not null, ref: > department.department_id]
  full_name varchar(100) [not null]
  specialty varchar(50)
  licence_no varchar(30) [not null, unique]
  phone varchar(20)
  email varchar(100) [unique]
}

Table nurse {
  nurse_id int [pk, increment]
  department_id int [not null, ref: > department.department_id]
  full_name varchar(100) [not null]
  specialty varchar(50)
  licence_no varchar(30) [not null, unique]
  phone varchar(20)
  email varchar(100) [unique]
}

// ---------- Patients and HMO ----------
Table patient {
  patient_id int [pk, increment]
  hospital_no varchar(20) [not null, unique]
  full_name varchar(100) [not null]
  date_of_birth date [not null]
  gender char(1) [note: 'M or F']
  phone varchar(20)
  address varchar(200)
  next_of_kin varchar(100)
  Note: 'HMO status is derived by the patient_hmo_status view'
}

Table hmo_provider {
  hmo_id int [pk, increment]
  provider_name varchar(100) [not null, unique]
  phone varchar(20)
  email varchar(100)
}

Table hmo_mapping {
  register_id int [pk, increment]
  hmo_id int [not null, ref: > hmo_provider.hmo_id]
  patient_id int [not null, ref: > patient.patient_id]
  enrollee_no varchar(30) [not null]
  start_date date [not null]
  end_date date [note: 'NULL = current registration']
  indexes {
    (hmo_id, enrollee_no) [unique]
  }
  Note: 'Only one active row (end_date NULL) per patient - enforced by a partial unique index in SQL'
}

// ---------- Clinical ----------
Table appointment {
  appointment_id int [pk, increment]
  patient_id int [not null, ref: > patient.patient_id]
  doctor_id int [not null, ref: > doctor.doctor_id]
  branch_id int [not null, ref: > branch.branch_id]
  start_time timestamp [not null]
  end_time timestamp [not null]
  status appointment_status [not null, default: 'scheduled']
  indexes {
    (doctor_id, start_time) [unique]
  }
}

Table consultation {
  consultation_id int [pk, increment]
  appointment_id int [not null, unique, ref: - appointment.appointment_id]
  symptoms text
  diagnosis text
  notes text
  created_at timestamp [not null, default: `now()`]
}

Table vital_signs {
  vital_signs_id int [pk, increment]
  consultation_id int [not null, ref: > consultation.consultation_id]
  nurse_id int [not null, ref: > nurse.nurse_id]
  temp_celsius decimal(4,1)
  bp_systolic int
  bp_diastolic int
  weight_kg decimal(5,1)
  recorded_at timestamp [not null, default: `now()`]
}

Table lab_test {
  lab_test_id int [pk, increment]
  name varchar(100) [not null, unique]
  sample_type varchar(30)
  price decimal(10,2) [not null]
}

Table lab_order {
  lab_order_id int [pk, increment]
  consultation_id int [not null, ref: > consultation.consultation_id]
  lab_test_id int [not null, ref: > lab_test.lab_test_id]
  status lab_status [not null, default: 'ordered']
  result_value text
  result_date timestamp
}

// ---------- Pharmacy ----------
Table drug {
  drug_id int [pk, increment]
  name varchar(100) [not null]
  form varchar(30) [note: 'tablet, syrup, injection...']
  strength varchar(30)
  unit_price decimal(10,2) [not null]
  indexes {
    (name, form, strength) [unique]
  }
}

Table prescription {
  prescription_id int [pk, increment]
  consultation_id int [not null, unique, ref: - consultation.consultation_id]
  issued_at timestamp [not null, default: `now()`]
}

Table prescription_item {
  prescription_id int [not null, ref: > prescription.prescription_id]
  drug_id int [not null, ref: > drug.drug_id]
  quantity int [not null]
  dosage_instructions varchar(200)
  indexes {
    (prescription_id, drug_id) [pk]
  }
}

Table drug_stock {
  branch_id int [not null, ref: > branch.branch_id]
  drug_id int [not null, ref: > drug.drug_id]
  quantity_on_hand int [not null, default: 0]
  reorder_level int [not null, default: 10]
  indexes {
    (branch_id, drug_id) [pk]
  }
}

// ---------- Billing ----------
Table invoice {
  invoice_id int [pk, increment]
  patient_id int [not null, ref: > patient.patient_id]
  appointment_id int [unique, ref: - appointment.appointment_id]
  issued_at timestamp [not null, default: `now()`]
  total_amount decimal(12,2) [not null, default: 0]
  status invoice_status [not null, default: 'unpaid']
}

Table payment {
  payment_id int [pk, increment]
  invoice_id int [not null, ref: > invoice.invoice_id]
  amount decimal(12,2) [not null]
  method payment_method [not null]
  paid_at timestamp [not null, default: `now()`]
}

// ---------- Groups (colour-coded boxes in the diagram) ----------
TableGroup organisation {
  branch
  department
  doctor
  nurse
}

TableGroup patients_hmo {
  patient
  hmo_provider
  hmo_mapping
}

TableGroup clinical {
  appointment
  consultation
  vital_signs
  lab_test
  lab_order
}

TableGroup pharmacy {
  drug
  prescription
  prescription_item
  drug_stock
}

TableGroup billing {
  invoice
  payment
}